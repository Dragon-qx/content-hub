# Dockerfile.api — ContentHub API (NestJS)
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9 --activate

# ── Stage 1: Install all dependencies (for build) ─────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/platform-sdk/package.json ./packages/platform-sdk/
RUN pnpm install --frozen-lockfile

# ── Stage 2: Build workspace + api ─────────────────────────────────
FROM deps AS builder
COPY . .
RUN pnpm --filter=@content-hub/shared-types build
RUN pnpm --filter=@content-hub/platform-sdk build
RUN cd /app/apps/api && pnpm exec prisma generate
RUN cd /app/apps/api && pnpm run build

# ── Stage 3: Runner (install prod deps directly) ───────────────────
FROM base AS runner
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/platform-sdk/package.json ./packages/platform-sdk/
RUN pnpm install --prod --frozen-lockfile
COPY --from=builder /app/apps/api/dist/apps/api/src ./dist
COPY --from=builder /app/apps/api/prisma ./prisma

EXPOSE 3000
CMD ["node", "dist/main"]
